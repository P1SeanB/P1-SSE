    "sqlAdminPassword": { "value": "<store-in-key-vault-or-pass-via-CLI-not-in-source-control>" },
    "sqlEntraAdminGroupObjectId": { "value": "<object-id-of-an-admin-group>" },
    "sqlEntraAdminGroupName": { "value": "<display-name-of-that-group>" }
  }
}
