{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": [
        "sse-users"
      ]
    },
    {
      "route": "/.auth/login/github",
      "statusCode": 404
    },
    {
      "route": "/*",
      "allowedRoles": [
        "sse-users"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "*.{css,js,svg,png,jpg,ico}"
    ]
  }
}
