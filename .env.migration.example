# Copy to .env.migration (gitignored) and fill in. Never commit the filled-in copy.
#
# THE ONLY VALUE YOU NEED.
# Supabase dashboard -> Project Settings -> API -> service_role key.
# It reaches everything: tables, user accounts, and files.
#
# It bypasses row-level security, which is why it can export everyone's records --
# and why it must never reach a commit, a screenshot, or the front end.
SUPABASE_SERVICE_KEY=

# OPTIONAL, and you probably cannot use it. A direct PostgreSQL connection needs a
# database password, which is separate from your dashboard login -- signing in with
# GitHub never sets one, which is why the dashboard shows [YOUR-PASSWORD].
# You can reset it under Project Settings -> Database (safe: the legacy app talks to
# PostgREST with the anon key, not to Postgres), but the service key makes it
# unnecessary. Left blank, the export uses the API and pages through everything.
SUPABASE_DB_URL=
