node_modules/
dist/
api/node_modules/
.env
.env.*
# ...but the TEMPLATE is meant to be shared. Without this negation .env.* swallows
# it and nobody else ever gets the file that explains which key to use.
!.env.migration.example
*.local
.swa/

# Azure Functions local settings. Holds whatever you point the API at while
# developing — historically a connection string. The .example is the committed one.
api/local.settings.json

# Real deployment parameters. Only the .example belongs in the repo; the filled-in
# versions carry tenant and group object ids for each environment.
infra/main.*.parameters.json
!infra/main.parameters.json.example

# Exported legacy data from the Supabase migration rehearsal. Real email addresses
# and business records — a working copy, never a backup, and never committed.
migration-data/
